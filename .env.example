# Mossie — variables de entorno (ejemplo, SIN secretos).
# Copia este archivo a .env.local y rellena con los valores de tu proyecto Supabase.

# --- Públicas (se envían al navegador; seguras) ---
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
# Project Settings -> API -> anon / publishable key (formato sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"

# --- Secretas (SOLO servidor; NUNCA subir al repo) ---
# Aún no se usan en la Fase 0. Se activarán cuando haga falta (p. ej. tareas de servidor).
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxx"
